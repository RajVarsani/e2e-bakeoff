# Copy to .env (bun loads it automatically). All values shown are defaults.
TEST_MODE=1
# 1 = ~10% of renders end in "failed"
FLAKY=0
API_PORT=5100
ADMIN_PORT=5101
PORTAL_PORT=5102
CRM_PORT=5103
# Public origins (what the browser uses)
ADMIN_URL=http://admin.localhost:5101
PORTAL_URL=http://portal.localhost:5102
CRM_URL=http://crm.localhost:5103
API_URL=http://api.localhost:5100
# Server-to-server URL the API uses to call the CRM
CRM_INTERNAL_URL=http://127.0.0.1:5103
# OAuth client registered at the CRM for the portal
CRM_CLIENT_ID=portal-app
CRM_CLIENT_SECRET=portal-secret
